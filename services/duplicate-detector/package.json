{
  "name": "duplicate-detector-service",
  "version": "2.0.0",
  "description": "Standalone gRPC microservice that flags likely-duplicate property listings (TypeScript)",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.11.3",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.5",
    "mongoose": "^8.5.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
