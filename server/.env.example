NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- MongoDB: primary store for users, properties, inquiries, reviews ---
MONGO_URI=mongodb://127.0.0.1:27017/estatehub

# --- PostgreSQL: transactional outbox (here) + preference scores (recommendation-service) ---
DATABASE_URL=postgres://estatehub:estatehub@localhost:5432/estatehub

# --- Kafka (comma-separated broker list) ---
KAFKA_BROKERS=localhost:9092
KAFKA_REPLICATION_FACTOR=1

# --- Microservices ---
DUPLICATE_SERVICE_URL=localhost:50051
RECOMMENDATION_SERVICE_URL=http://localhost:5100
# Shared secret for server -> recommendation-service calls
INTERNAL_API_TOKEN=dev-internal-token

# Optional: override where uploaded images are stored (default ./uploads)
# UPLOAD_DIR=./uploads
